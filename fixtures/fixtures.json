 {
  "id": "F10-sumifs-legacy-whole-column",
  "issue": 8154,
  "sources": [
   "https://github.com/dream-num/univer/issues/8154",
   "https://support.microsoft.com/en-us/office/implicit-intersection-operator-ce3be07b-0101-4450-a24e-c1c999be2b34"
  ],
  "note": "Issue's own data: Data!A = k{i%300}, Data!B = i+1 for 2,500 rows; Summary!A = k0..k299; Summary!B = SUMIFS(Data!B:B,Data!A:A,$A:$A) stored WITHOUT @ (legacy, non-array), which is how pre-dynamic-array Excel files store it. Per the issue and MS 'Implicit intersection operator', Excel shows it as @$A:$A and returns the same-row total. Issue states k0 total 10809, k299 total 10800. Cached values for other rows are computed from the same data definition and are not asserted.",
  "cases": [
   [
    "Summary",
    "B2",
    "SUMIFS(Data!B:B,Data!A:A,$A:$A)",
    10809,
    "issue #8154 text (k0 total)"
   ],
   [
    "Summary",
    "B301",
    "SUMIFS(Data!B:B,Data!A:A,$A:$A)",
    10800,
    "issue #8154 text (k299 total)"
   ]
  ],
  "file": "F10-sumifs-legacy-whole-column.xlsx"
 },
